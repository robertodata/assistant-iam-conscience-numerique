# Configuration locale du backend
# Copiez ce fichier vers backend/.env puis adaptez les valeurs.

# Laissez vide si vous ne voulez pas appeler OpenAI.
OPENAI_API_KEY=

# Modèle utilisé uniquement par l'endpoint d'explication.
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_TOKENS=200
AI_TIMEOUT_SECONDS=20

# Contexte AWS utilisé pour construire les ARN d'exemple.
# AWS_ACCOUNT_ID doit être remplacé par le vrai compte en production.
AWS_REGION=eu-west-3
AWS_ACCOUNT_ID=123456789012

# Origines autorisées à appeler l'API depuis un navigateur.
# Plusieurs valeurs peuvent être séparées par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
